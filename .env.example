# Telegram Bot Configuration (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (from @userinfobot or /start)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Check interval in seconds (default: 7200 seconds = 2 hours)
CHECK_INTERVAL_SECONDS=7200

# Optional: GitHub Personal Access Token (classic PAT with 'repo' scope)
# Only required if you want to track private repositories or bypass rate limits
GITHUB_TOKEN=
